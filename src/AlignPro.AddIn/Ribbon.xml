<?xml version="1.0" encoding="UTF-8"?>
<!--
  The AlignPro tab. Two dropdowns carry the state that the six align buttons are crossed with -
  what to align against, and which rectangle to measure - so one small set of buttons covers the
  whole matrix rather than needing a button per combination.
-->
<!--
  There is deliberately no <commands> repurposing here. Routing the built-in Undo to our own stack was
  implemented and measured: PowerPoint parses the markup and never invokes the callback, so it simply
  does not work in this host. It is also no longer needed. Undo is made correct at the source instead:
  every operation opens its own native undo entry first - see UndoBoundary.cs.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="AlignProTab" label="AlignPro">

        <group id="grpTarget" label="Align to">
          <dropDown id="ddReference"
                    label="Reference"
                    sizeString="Selection bounds"
                    getSelectedItemIndex="GetReferenceIndex"
                    onAction="OnReferenceChange"
                    screentip="What the align and distribute verbs measure against"
                    supertip="Anchor uses the last shape you selected. Selection bounds is what PowerPoint does natively.">
            <item id="refAnchor" label="Anchor (last selected)" />
            <item id="refSelection" label="Selection bounds" />
            <item id="refSlide" label="Slide" />
            <item id="refMargins" label="Slide margins" />
            <item id="refPlaceholder" label="Content placeholder" />
          </dropDown>
          <dropDown id="ddBounds"
                    label="Measure"
                    sizeString="Visual bounds"
                    getSelectedItemIndex="GetBoundsIndex"
                    onAction="OnBoundsChange"
                    screentip="Which rectangle of each shape to align"
                    supertip="Shape frame is PowerPoint's own rectangle, which ignores rotation. Visual bounds is what you actually see. Text bounds aligns the text rather than the frame.">
            <item id="bndFrame" label="Shape frame" />
            <item id="bndVisual" label="Visual bounds" />
            <item id="bndText" label="Text bounds" />
          </dropDown>
          <editBox id="ebMargin"
                   label="Margin (pt)"
                   sizeString="0000"
                   getText="GetMarginText"
                   onChange="OnMarginChange"
                   screentip="Inset used by the Slide margins reference" />
        </group>

        <group id="grpAlign" label="Align">
          <button id="btnAlignLeft" label="Left" size="large"
                  getImage="GetButtonImage" onAction="OnAlign" />
          <button id="btnAlignCentreH" label="Centre" size="large"
                  getImage="GetButtonImage" onAction="OnAlign" />
          <button id="btnAlignRight" label="Right" size="large"
                  getImage="GetButtonImage" onAction="OnAlign" />
          <button id="btnAlignTop" label="Top" size="large"
                  getImage="GetButtonImage" onAction="OnAlign" />
          <button id="btnAlignCentreV" label="Middle" size="large"
                  getImage="GetButtonImage" onAction="OnAlign" />
          <button id="btnAlignBottom" label="Bottom" size="large"
                  getImage="GetButtonImage" onAction="OnAlign" />
        </group>

        <group id="grpDistribute" label="Distribute">
          <dropDown id="ddDistributeMode"
                    label="Space by"
                    sizeString="Trailing edges"
                    getSelectedItemIndex="GetDistributeModeIndex"
                    onAction="OnDistributeModeChange"
                    screentip="Which feature of each shape gets spaced evenly"
                    supertip="All four agree when the shapes are the same size, and diverge as soon as they differ.">
            <item id="dmLeading" label="Leading edges" />
            <item id="dmCentre" label="Centres" />
            <item id="dmTrailing" label="Trailing edges" />
            <item id="dmGap" label="Space between" />
          </dropDown>
          <editBox id="ebSpacing"
                   label="Exact (pt)"
                   sizeString="0000"
                   getText="GetSpacingText"
                   onChange="OnSpacingChange"
                   screentip="Exact spacing in points; leave blank to even out what is already there"
                   supertip="In the three edge and centre modes this is the pitch. In Space between it is the gap." />
          <button id="btnDistributeH" label="Horizontally" size="large"
                  getImage="GetButtonImage" onAction="OnDistribute" />
          <button id="btnDistributeV" label="Vertically" size="large"
                  getImage="GetButtonImage" onAction="OnDistribute" />
        </group>

        <group id="grpSize" label="Match size">
          <button id="btnMatchWidth" label="Width" getImage="GetButtonImage" onAction="OnMatchSize"
                  screentip="Match every shape's width to the anchor" />
          <button id="btnMatchHeight" label="Height" getImage="GetButtonImage" onAction="OnMatchSize"
                  screentip="Match every shape's height to the anchor" />
          <button id="btnMatchBoth" label="Both" getImage="GetButtonImage" onAction="OnMatchSize"
                  screentip="Match width and height to the anchor" />
          <toggleButton id="tbResizeFromCentre" label="From centre" getImage="GetButtonImage"
                       getPressed="GetResizeFromCentre" onAction="OnResizeFromCentreChange"
                       screentip="Hold each shape's centre while resizing instead of its top-left corner" />
          <!--
            There is a second "Margin (pt)" box in grpTarget, for the slide inset. The two are
            unrelated settings that happen to share a name, so each screentip says which is which -
            the group heading above the box is what tells them apart at a glance.
          -->
          <editBox id="ebSizeMargin"
                   label="Margin (pt)"
                   sizeString="0000"
                   getText="GetSizeMarginText"
                   onChange="OnSizeMarginChange"
                   screentip="How much smaller than the anchor each shape is, measured on each side"
                   supertip="A margin of 10 leaves a 10pt border showing all round, so each dimension drops by 20. Negative numbers make the shapes larger instead. Turn From centre on for concentric rings. This is not the slide margin in the Align to group." />
          <dropDown id="ddSizeMarginMode"
                    label="Apply margin"
                    sizeString="All the same"
                    getSelectedItemIndex="GetSizeMarginModeIndex"
                    onAction="OnSizeMarginModeChange"
                    screentip="Whether the margin applies at all, and whether it accumulates"
                    supertip="All the same puts every shape one margin inside the anchor. Cascade tiers them along the order you selected in, so the first shape you selected ends smallest.">
            <item id="smOff" label="Off" />
            <item id="smUniform" label="All the same" />
            <item id="smCascade" label="Cascade" />
          </dropDown>
        </group>

        <!--
          Ordering reshuffles the selection within the z-positions it already occupies, so shapes that
          were not selected keep the layer they were on. That is the difference from PowerPoint's own
          Bring to front, which drags the whole selection over everything else.
        -->
        <group id="grpOrder" label="Order">
          <button id="btnOrderStack" label="Stack" size="large"
                  getImage="GetButtonImage" onAction="OnOrder"
                  screentip="Stack the selection in the order you selected it"
                  supertip="The first shape you selected ends on top and the last at the bottom. Shapes you did not select keep their own layer." />
          <button id="btnOrderReverse" label="Reverse" size="large"
                  getImage="GetButtonImage" onAction="OnOrder"
                  screentip="Stack the selection in reverse selection order"
                  supertip="The mirror image of Stack: the first shape you selected ends at the bottom." />
        </group>

        <group id="grpArrange" label="Arrange">
          <editBox id="ebGridColumns" label="Columns" sizeString="0000"
                   getText="GetGridColumnsText" onChange="OnGridColumnsChange"
                   screentip="Leave blank for a near-square grid" />
          <button id="btnGrid" label="Grid" getImage="GetButtonImage" onAction="OnGrid"
                  screentip="Arrange the selection into an even grid, leaving sizes alone" />
        </group>

        <!--
          AlignPro's own undo. Ctrl+Z is now safe too - UndoBoundary gives every operation its own
          native undo entry - so these buttons are a labelled convenience rather than the only safe
          route. The label names the operation, which PowerPoint's own Undo does not.
        -->
        <group id="grpUndo" label="AlignPro undo">
          <button id="btnUndo" getLabel="GetUndoLabel" size="large" imageMso="Undo"
                  getEnabled="GetUndoEnabled" onAction="OnUndo"
                  screentip="Reverse the last AlignPro operation"
                  supertip="Reverses one AlignPro operation and names it. Ctrl+Z does the same thing." />
          <button id="btnRedo" getLabel="GetRedoLabel" size="large" imageMso="Redo"
                  getEnabled="GetRedoEnabled" onAction="OnRedo"
                  screentip="Reapply the operation just undone" />
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
