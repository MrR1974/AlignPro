# .NET
bin/
obj/
*.user

# VSTO / ClickOnce build output
*.vsto
*.dll.manifest
*.application
publish/
app.publish/

# Signing material - generated locally by tools/New-DevSigningCertificate.ps1, never committed
*.pfx
*.snk
Signing.props

# Release output - rebuild with tools/New-Release.ps1
dist/

# Editor
.vs/
.vscode/*
!.vscode/extensions.json

# OS
Thumbs.db
.DS_Store

# NOTE: sample/AlignPro-Sample.pptx is deliberately committed. It is the fixture the README points
# people at, and tools/New-SampleDeck.ps1 regenerates it.

# Office lock files. Because the deck above is both committed and meant to be opened, ~$AlignPro-
# Sample.pptx appears beside it whenever anyone tries it, and is easy to sweep into a commit.
~$*

# Generated at build time from the signed manifest - belongs to one build, never committed
installer/PublicKey.wxi
