# .NET
bin/
obj/
*.user

# VSTO / ClickOnce publish output
*.vsto
*.dll.manifest
*.application
publish/
app.publish/

# Signing material - never commit a key
*.pfx
*.snk

# Editor
.vs/
.vscode/*
!.vscode/extensions.json

# OS
Thumbs.db
.DS_Store

# Machine-local VSTO signing, generated by tools/New-DevSigningCertificate.ps1
Signing.props

# Generated sample deck (binary; rebuild with tools/New-SampleDeck.ps1)
sample/
*.pptx

# Release zips (rebuild with tools/New-Release.ps1)
dist/

# Generated at build time from the signed manifest - belongs to one build, never committed
installer/PublicKey.wxi
